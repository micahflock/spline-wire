{
  "name": "spline-wire-relay",
  "private": true,
  "type": "module",
  "scripts": {
    "relay": "node --experimental-strip-types dev-relay.ts",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:worker": "RELAY_TARGET=worker vitest run test/relay.itest.ts",
    "check:browser": "node --experimental-strip-types test/browser-check.ts",
    "check:desktop": "node --experimental-strip-types test/desktop-check.ts",
    "demo": "node --experimental-strip-types demo/serve.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0",
    "ws": "^8.18.0"
  }
}
