{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": ["src", "relay", "vite.config.ts"],
  // The relay's server side needs its own packages (relay/package.json) and
  // Cloudflare's types; relay/tsconfig*.json check it.
  "exclude": ["node_modules", "relay/node_modules", "relay/worker.ts", "relay/dev-relay.ts", "relay/test", "relay/demo"]
}
